# Root-level ignore

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Secrets & Environment Variables (Never commit!)
.env
.env.*
.env.local
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
frontend/.env.local
!frontend/.env.example

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Python Virtual Environments & Caches
venv/
.venv/
backend/venv/
backend/.venv/
__pycache__/
backend/__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.turbo/
frontend/.turbo/
*.tsbuildinfo
frontend/*.tsbuildinfo
.eslintcache
frontend/.eslintcache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
